  "triggers": {
    "keywords": ["plan a trip", "plan my trip", "trip itinerary", "itinerary for", "plan a city break", "plan a weekend in", "plan a few days in"],
    "slashCommand": "trip"
  },
  "tools": ["web_search", "extract_article", "web_fetch", "create_pdf", "create_reminder", "create_widget", "pin_widget", "get_time"],
  "leadTool": "web_search",
  "permissions": { "create_reminder": "ask", "create_widget": "ask", "pin_widget": "ask" },
  "modelHint": "cloud",
  "privacy": "allow_cloud"
}
