{
  "schemaVersion": 1,
  "id": "trip-brief",
  "name": "Trip brief",
  "version": "1.0.0",
  "description": "A city trip planned from research: day plans with real hours and prices, a PDF itinerary, booking reminders and a countdown widget.",
  "author": "NuJan",
  "license": "Apache-2.0",
